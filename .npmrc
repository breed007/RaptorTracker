# Server dependencies never need to run install scripts:
#  - better-sqlite3 and bcrypt ship prebuilt binaries for linux/macOS/windows on
#    x64 and arm64 and load them at runtime.
#  - npm ci still triggers `node-gyp rebuild` for better-sqlite3 (it ignores the
#    package's gypfile:false), which needs Python and a C++ compiler and spends
#    minutes compiling SQLite on a Raspberry Pi into a binary nothing loads.
# The client has its own package root, so this does not affect Vite/esbuild.
# Startup and `npm test` fail loudly if a native module cannot load.
ignore-scripts=true

# RaptorTracker — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000

# Random string used to sign session cookies — make this long and unique
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=changeme-replace-with-a-long-random-string

# ── Admin Account ─────────────────────────────────────────────
# Credentials for the built-in admin user (created on first db:init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Data Storage ──────────────────────────────────────────────
# Directory where the SQLite database is stored
DATA_DIR=./data

# Directory where uploaded photos, stickers, and attachments are stored
UPLOAD_DIR=./data/uploads

# ── Environment ───────────────────────────────────────────────
# Use "development" locally, "production" on the server.
# In production, SESSION_SECRET (above) is REQUIRED — the server refuses to
# start without it rather than fall back to a public default key.
NODE_ENV=development

# Set to true only when the app is served over HTTPS, so the session cookie
# is not sent in cleartext. Behind a plain-HTTP reverse proxy on localhost,
# leave this false.
COOKIE_SECURE=false

# ── Reminder schedule (optional) ──────────────────────────────
# Hour of day (0-23) the daily reminder digest runs, and the timezone to
# interpret it in. Default: 8am in the server's local time.
REMINDER_HOUR=8
# REMINDER_TZ=America/New_York

# ── Email Reminders (optional) ────────────────────────────────
# SMTP credentials for service/warranty reminder emails. Leave SMTP_HOST
# blank to disable email entirely. The recipient address and on/off
# toggles are set in the app under Notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address on reminder emails (defaults to SMTP_USER if blank)
SMTP_FROM=
